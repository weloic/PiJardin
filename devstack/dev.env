# Credentials for the local debug stack. Committed on purpose.
#
# This stack binds to 127.0.0.1 only and holds nothing but a copy of well-depth readings, so
# there is no secret here worth protecting — and inventing one would only put a manual step
# between a fresh clone and a working dashboard. Nothing in this file is ever used on the Pi:
# up.sh substitutes DEV_TOKEN into a *generated* copy of the production datasource config,
# and the real token stays in the Pi's own .env, which is gitignored.
DEV_TOKEN=pijardin-devstack-token

# Must match the production datasource in grafana/provisioning/datasources/influxdb.yaml,
# because the dashboard's Flux names the bucket literally: from(bucket: "puit").
DEV_ORG=PiJardin
DEV_BUCKET=puit
