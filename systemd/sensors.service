# A .service unit describes how to run a program.
# This one is triggered by sensors.timer — it is not meant to be started manually.

[Unit]
Description=Read and record sensor data

[Service]
# oneshot means: run the command once and exit.
# systemd considers the service "done" as soon as the script finishes.
Type=oneshot

# The Python script to execute.
ExecStart=/usr/bin/python3 /home/pi/PiJardin/sensors.py     # TODO: update

# Run as the unprivileged "pi" user instead of root, for security.
User=pi
