# A .service unit describes how to run a program.
# This one is triggered by sensors.timer — it is not meant to be started manually.
# NOTE: @@PLACEHOLDER@@ tokens are substituted by deploy/bootstrap.sh at install time.

[Unit]
Description=Read and record sensor data

[Service]
# oneshot means: run the command once and exit.
# systemd considers the service "done" as soon as the script finishes.
Type=oneshot

# Inject all variables from .env (including secrets) into the process environment.
EnvironmentFile=@@REPO_DIR@@/.env

# The Python script to execute.
ExecStart=@@VENV_DIR@@/bin/python3 @@REPO_DIR@@/sensors/read_puit.py

# Run as the unprivileged user instead of root, for security.
User=@@SERVICE_USER@@
