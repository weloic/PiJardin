      "targets": [
        {
          "query": "data = from(bucket: \"puit\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r._measurement == \"height_measure\")\n  |> filter(fn: (r) => r._field == \"lenght_median\")\n  |> map(fn: (r) => ({ r with _value: (220.0 - r._value) * 40.0 }))\n  |> keep(columns: [\"_time\", \"_value\"])\n\n// A time window, not a number of points: the cadence is no longer uniform, so \"the first\n// 6 points\" is no longer \"the first half hour\" — and a burst of pump-edge readings at\n// either end would otherwise decide the whole answer.\nfirstAvg = data |> range(start: -24h, stop: -23h30m) |> mean() |> set(key: \"k\", value: \"first\")\nlastAvg  = data |> range(start: -30m)               |> mean() |> set(key: \"k\", value: \"last\")\n\nunion(tables: [firstAvg, lastAvg])\n  |> pivot(rowKey: [], columnKey: [\"k\"], valueColumn: \"_value\")\n  |> map(fn: (r) => ({ _time: now(), _value: r.last - r.first }))",
          "refId": "A"
        }
      ],
      "title": "Variation eau - 24 dernières heures",
      "type": "stat"
    },
